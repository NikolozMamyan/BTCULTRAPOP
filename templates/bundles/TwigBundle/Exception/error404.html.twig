{% extends 'front/base.html.twig' %}

{% block title %}{{ 'error.not_found.title'|trans }} | ULTRAPOP{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}
{% block canonical_url %}{% endblock %}
{% block main %}
    <section class="max-w-3xl mx-auto px-5 py-16 text-center">
        <h1 class="font-display text-3xl font-bold mb-4">{{ 'error.not_found.title'|trans }}</h1>
        <p class="mb-6">{{ 'error.not_found.text'|trans }}</p>
        <a class="text-primary underline" href="{{ path('app_front_boutique') }}">{{ 'product.back_shop'|trans }}</a>
    </section>
{% endblock %}
