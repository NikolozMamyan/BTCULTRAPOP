{% extends 'front/base.html.twig' %}

{% block title %}{{ 'checkout.cancel.page_title'|trans }}{% endblock %}
{% block storefront_data %}data-page="checkout-cancel"{% endblock %}

{% block main %}
    <section class="checkout-result">
        <article class="checkout-result__card checkout-result__card--cancel">
            <span class="checkout-result__icon">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </span>
            <p class="checkout-result__eyebrow">{{ 'checkout.cancel.eyebrow'|trans }}</p>
            <h1>{{ 'checkout.cancel.title'|trans }}</h1>
            <p>{{ 'checkout.cancel.text'|trans }}</p>

            {% if order %}
                <div class="checkout-result__order">
                    <span>{{ 'checkout.order_number'|trans }}</span>
                    <strong>{{ order.orderNumber }}</strong>
                </div>
            {% endif %}

            <div class="checkout-result__actions">
                {% if payment_recovery_url %}
                    <a href="{{ payment_recovery_url }}" class="checkout-result__primary" data-turbo="false">
                        {{ 'checkout.cancel.resume'|trans }}
                        <i class="fa-solid fa-lock"></i>
                    </a>
                {% endif %}
                {% if cart_recovery_url %}
                    <form method="post" action="{{ cart_recovery_url }}" data-turbo="false">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('checkout_cart_recovery_' ~ order.id) }}">
                        <button type="submit" class="checkout-result__secondary">
                            {{ 'checkout.cancel.modify_cart'|trans }}
                            <i class="fa-solid fa-basket-shopping"></i>
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('app_front_boutique') }}" class="checkout-result__secondary">
                    {{ 'common.shop'|trans }}
                </a>
            </div>
        </article>
    </section>
{% endblock %}
