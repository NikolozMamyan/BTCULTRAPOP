{% extends 'front/base.html.twig' %}
{% set landing_route = landing.field == 'license' ? 'app_front_license' : 'app_front_category' %}
{% set landing_url = seo_origin ~ path(landing_route, {slug: landing.slug}) %}

{% block title %}{{ landing.name }} — {{ 'catalog.landing.title'|trans }} | ULTRAPOP{% endblock %}
{% block meta_description %}{{ 'catalog.landing.meta'|trans({'%name%': landing.name}) }}{% endblock %}
{% block canonical_url %}{{ landing_url }}{% endblock %}
{% block storefront_data %}data-page="shop"{% endblock %}
{% block structured_data %}
    {{ parent() }}
    {% set items = [] %}
    {% for product in landing.products %}
        {% set items = items|merge([{'@type': 'ListItem', position: loop.index, name: product.name, url: seo_origin ~ path('app_front_product', {id: product.id, slug: product.slug})}]) %}
    {% endfor %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org', '@type': 'CollectionPage', name: landing.name, url: landing_url,
        mainEntity: {'@type': 'ItemList', numberOfItems: items|length, itemListElement: items}
    }|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
            {'@type': 'ListItem', position: 1, name: 'common.home'|trans, item: seo_origin ~ path('app_front_home')},
            {'@type': 'ListItem', position: 2, name: 'common.shop'|trans, item: seo_origin ~ path('app_front_boutique')},
            {'@type': 'ListItem', position: 3, name: landing.name, item: landing_url}
        ]
    }|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block main %}
    {% if landing.field == 'license' %}
        {% include 'front/boutique/_catalog.html.twig' with {
            products: landing.all_products,
            filter_items: landing.items,
            filter_label: 'common.licenses',
            filter_icon: 'fa-solid fa-clapperboard',
            filter_field: 'license',
            max_price: landing.max_price,
            title: 'common.licenses',
            initial_category: landing.name,
            selected_count: landing.products|length
        } only %}
    {% else %}
        {% include 'front/boutique/_catalog.html.twig' with {
            products: landing.all_products,
            categories: landing.items,
            max_price: landing.max_price,
            hero_images: boutique_hero_images,
            hero_mobile_images: boutique_hero_mobile_images,
            hero_mobile_breakpoint: boutique_hero_mobile_breakpoint,
            show_hero: true,
            initial_category: landing.name,
            selected_count: landing.products|length
        } only %}
    {% endif %}
    <section class="shop-seo-copy max-w-7xl mx-auto px-5" data-catalog-category="{{ landing.name }}">
        <h2>{{ landing.name }} — ULTRAPOP</h2>
        <p>{{ (landing.field == 'license' ? 'catalog.landing.license_intro' : 'catalog.landing.category_intro')|trans({'%name%': landing.name}) }}</p>
        {% if landing.field == 'category' and ('catalog.category.' ~ landing.slug)|trans != 'catalog.category.' ~ landing.slug %}
            <p>{{ ('catalog.category.' ~ landing.slug)|trans }}</p>
        {% endif %}
        <p>{{ 'catalog.landing.guide'|trans }}</p>
    </section>
{% endblock %}
