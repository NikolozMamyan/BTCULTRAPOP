{% extends 'base.html.twig' %}

{% block body_class %}font-sans antialiased overflow-x-hidden{% endblock %}

{% block head_tracking %}
    {% set gtm_id = gtm_container_id|default('')|trim %}
    {% if gtm_id %}
        <script>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','{{ gtm_id|e('js') }}');
        </script>
    {% endif %}
{% endblock %}

{% block body_tracking %}
    {% set gtm_id = gtm_container_id|default('')|trim %}
    {% if gtm_id %}
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ gtm_id|url_encode }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    {% endif %}
{% endblock %}

{% block body %}
    {% set current_route = app.request.attributes.get('_route')|default('') %}
    {% set popup_allowed = not app.user
        and not (current_route starts with 'app_front_profil')
        and not (current_route starts with 'app_front_profile_')
        and not (current_route starts with 'app_auth_')
    %}
    {% set promotional_popup = popup_allowed ? storefront_popup() : null %}
    {% set favorite_count = storefront_favorite_count() %}
    <div
        id="storefront-app"
        data-controller="cart favorites product-preview"
        {% block storefront_data %}data-page="home"{% endblock %}
        data-home-url="{{ path('app_front_home') }}"
        data-shop-url="{{ path('app_front_boutique') }}"
        data-licenses-url="{{ path('app_front_licences') }}"
        data-sales-url="{{ path('app_front_soldes') }}"
        data-wishlist-url="{{ path('app_front_favoris') }}"
        data-cart-url-value="{{ path('app_api_cart_show') }}"
        data-cart-add-url-value="{{ path('app_api_cart_item_add') }}"
        data-cart-page-url-value="{{ path('app_front_cart') }}"
        data-cart-view-label-value="{{ 'cart.view'|trans }}"
        data-cart-csrf-value="{{ csrf_token('cart_api') }}"
        data-cart-error-value="{{ 'cart.flash.error'|trans }}"
        data-favorites-toggle-url-value="{{ path('app_api_favorite_toggle', {productId: 0})|replace({'/0': '/__PRODUCT_ID__'}) }}"
        data-favorites-login-url-value="{{ path('app_front_profil') }}"
        data-favorites-login-label-value="{{ 'auth.login.submit'|trans }}"
        data-favorites-csrf-value="{{ csrf_token('favorite_api') }}"
        data-favorites-error-value="{{ 'favorite.flash.error'|trans }}"
        data-cart-shipping-empty="{{ 'overlay.shipping_empty'|trans }}"
        data-cart-empty-eyebrow="{{ 'cart.empty_eyebrow'|trans }}"
        data-cart-empty-title="{{ 'overlay.cart_empty_title'|trans }}"
        data-cart-empty-text="{{ 'overlay.cart_empty_text'|trans }}"
        data-cart-empty-action="{{ 'overlay.discover_shop'|trans }}"
        data-carousel-go-to="{{ 'home.carousel.go_to'|trans }}"
    >
        {% include 'front/components/navigation/_announcement.html.twig' %}
        {% include 'front/components/navigation/_header.html.twig' %}

        {% for message in app.flashes('newsletter_success') %}
            <div role="status" class="mx-auto mt-4 max-w-3xl rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-3 text-center text-sm font-semibold text-emerald-800">
                <i class="fa-solid fa-circle-check mr-2"></i>{{ message|trans }}
            </div>
        {% endfor %}
        {% for message in app.flashes('newsletter_error') %}
            <div role="alert" class="mx-auto mt-4 max-w-3xl rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-center text-sm font-semibold text-red-700">
                <i class="fa-solid fa-circle-exclamation mr-2"></i>{{ message|trans }}
            </div>
        {% endfor %}

        <main class="relative">
            {% block main %}{% endblock %}
        </main>

        {% include 'front/components/overlay/_search.html.twig' %}
        {% include 'front/components/overlay/_page_skeleton.html.twig' %}
        {% include 'front/components/overlay/_product_preview.html.twig' %}
        {% include 'front/components/overlay/_cart_drawer.html.twig' %}
        {% include 'front/components/overlay/_toast.html.twig' %}
        {% if promotional_popup %}
            {% include 'front/components/overlay/_visitor_promo_popup.html.twig' with {popup: promotional_popup} only %}
        {% endif %}
        {% include 'front/components/overlay/_back_to_top.html.twig' %}
        {% include 'front/components/_footer.html.twig' %}
        {% include 'front/components/navigation/_mobile.html.twig' %}
    </div>
{% endblock %}
