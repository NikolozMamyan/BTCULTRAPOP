{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ 'admin.sage_order.index.title'|trans }}{% endblock %}

{% block admin_content %}
    <section class="admin-sage-orders" data-controller="admin-sage-orders">
        <div class="admin-page-heading admin-page-heading--actions">
            <div>
                <span>{{ 'admin.sage_order.index.eyebrow'|trans }}</span>
                <h1>{{ 'admin.sage_order.index.title'|trans }}</h1>
                <p>{{ 'admin.sage_order.index.subtitle'|trans }}</p>
            </div>
        </div>

        <div class="admin-stats-grid admin-order-stats">
            {% for stat in stats %}
                <article class="admin-stat-card admin-stat-card--{{ stat.tone }}">
                    <span class="admin-stat-card__icon">
                        <i class="{{ stat.icon }}" aria-hidden="true"></i>
                    </span>
                    <div>
                        <small>{{ stat.label|trans }}</small>
                        <strong>{{ stat.value }}</strong>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="admin-flashes" data-admin-sage-orders-target="message"></div>

        <article class="admin-panel admin-sage-orders-panel">
            <div class="admin-panel__heading">
                <div>
                    <span>{{ 'admin.sage_order.index.list_eyebrow'|trans }}</span>
                    <h2>{{ 'admin.sage_order.index.list_title'|trans({'%count%': orders|length}) }}</h2>
                </div>
            </div>

            {% if orders %}
                <div class="admin-order-table admin-sage-order-table">
                    <div class="admin-order-table__row admin-order-table__row--head">
                        <span>{{ 'admin.sage_order.table.order'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.customer'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.paid_at'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.total'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.lines'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.status'|trans }}</span>
                        <span>{{ 'admin.sage_order.table.action'|trans }}</span>
                    </div>

                    {% for order in orders %}
                        <div class="admin-order-table__row">
                            <a href="{{ path('app_admin_orders_show', {id: order.id}) }}" class="admin-order-number">
                                <strong>{{ order.number }}</strong>
                                <small>{{ order.created_at|date('d/m/Y H:i') }}</small>
                            </a>
                            <span class="admin-order-customer">
                                <strong>{{ order.customer ?: 'admin.order.unknown_customer'|trans }}</strong>
                                <small>{{ order.email ?: 'admin.order.email_pending'|trans }}</small>
                            </span>
                            <span>{{ order.paid_at ? order.paid_at|date('d/m/Y H:i') : 'admin.sage_order.table.paid_at_unknown'|trans }}</span>
                            <strong>{{ order.total }}</strong>
                            <span>{{ 'admin.sage_order.table.lines_count'|trans({'%count%': order.items_count}) }}</span>
                            {% if order.exported %}
                                <span class="admin-order-badge admin-order-badge--paid">
                                    {{ 'admin.sage_order.status.sent'|trans({'%date%': order.sent_at|date('d/m/Y H:i')}) }}
                                </span>
                            {% else %}
                                <span class="admin-order-badge admin-order-badge--payment-pending">
                                    {{ 'admin.sage_order.status.pending'|trans }}
                                </span>
                            {% endif %}
                            <div class="admin-product-actions">
                                {% if order.exported %}
                                    <button type="button" class="admin-secondary-button admin-sage-order-send" disabled>
                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                        {{ 'admin.sage_order.action.sent'|trans }}
                                    </button>
                                {% else %}
                                    <form
                                        method="post"
                                        action="{{ path('app_admin_sage_orders_send', {id: order.id}) }}"
                                        data-turbo="false"
                                        data-action="submit->admin-sage-orders#send"
                                    >
                                        <button type="submit" class="admin-action-button admin-sage-order-send">
                                            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                                            {{ 'admin.sage_order.action.send'|trans }}
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="admin-empty-state">
                    <i class="fa-solid fa-file-invoice" aria-hidden="true"></i>
                    <p>{{ 'admin.sage_order.index.empty'|trans }}</p>
                </div>
            {% endif %}
        </article>
    </section>
{% endblock %}
