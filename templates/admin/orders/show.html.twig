{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ order.number }}{% endblock %}

{% block admin_content %}
    <section class="admin-order-show">
        <div class="admin-page-heading admin-page-heading--actions">
            <div>
                <span>{{ 'admin.order.show.eyebrow'|trans }}</span>
                <h1>{{ order.number }}</h1>
                <p>{{ 'admin.order.show.subtitle'|trans({'%date%': order.created_at|date('d/m/Y H:i')}) }}</p>
            </div>
            <div class="admin-heading-actions">
                <a href="{{ path('app_admin_orders_export', {order: order.id}) }}" class="admin-secondary-button">
                    <i class="fa-solid fa-file-export"></i>
                    {{ 'admin.order.action.export_one'|trans }}
                </a>
                <a href="{{ path('app_admin_orders_index') }}" class="admin-secondary-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    {{ 'admin.order.back_to_list'|trans }}
                </a>
            </div>
        </div>

        <article class="admin-panel admin-order-management">
            <div>
                <span class="admin-order-management__icon"><i class="fa-solid fa-arrows-rotate"></i></span>
                <div>
                    <strong>{{ 'admin.order.status.manage_title'|trans }}</strong>
                    <small>{{ 'admin.order.status.manage_text'|trans }}</small>
                </div>
            </div>
            {{ form_start(status_form, {attr: {class: 'admin-order-status-form'}}) }}
                <div class="admin-field">
                    {{ form_widget(status_form.status) }}
                    {{ form_errors(status_form.status) }}
                </div>
                <button type="submit" class="admin-action-button">
                    <i class="fa-solid fa-floppy-disk"></i>
                    {{ 'admin.order.status.submit'|trans }}
                </button>
            {{ form_end(status_form) }}
        </article>

        <div class="admin-order-show__grid">
            <article class="admin-panel admin-order-summary-panel">
                <div class="admin-panel__heading">
                    <div>
                        <span>{{ 'admin.order.show.summary_eyebrow'|trans }}</span>
                        <h2>{{ 'admin.order.show.summary_title'|trans }}</h2>
                    </div>
                </div>

                <div class="admin-order-summary">
                    <div>
                        <span>{{ 'admin.order.status'|trans }}</span>
                        <strong class="admin-order-badge admin-order-badge--{{ order.status }}">{{ order.status_key|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.payment'|trans }}</span>
                        <strong class="admin-order-badge admin-order-badge--payment-{{ order.payment_status }}">{{ order.payment_status_key|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.total'|trans }}</span>
                        <strong>{{ order.total }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.items'|trans }}</span>
                        <strong>{{ order.items_count }}</strong>
                    </div>
                </div>

                <div class="admin-order-recovery">
                    <div class="admin-order-recovery__copy">
                        <span class="admin-order-recovery__icon">
                            <i class="fa-solid fa-bolt"></i>
                        </span>
                        <div>
                            <strong>{{ 'admin.order.recovery.title'|trans }}</strong>
                            <small>
                                {% if payment_recovery.last_sent_at %}
                                    {{ 'admin.order.recovery.last_sent'|trans({
                                        '%date%': payment_recovery.last_sent_at|date('d/m/Y à H:i')
                                    }) }}
                                {% else %}
                                    {{ 'admin.order.recovery.text'|trans }}
                                {% endif %}
                            </small>
                        </div>
                    </div>

                    {% if payment_recovery.available %}
                        <form
                            method="post"
                            action="{{ path('app_admin_orders_payment_reminder', {id: order.id}) }}"
                            onsubmit="return confirm('{{ 'admin.order.recovery.confirm'|trans|e('js') }}')"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_order_payment_reminder_' ~ order.id) }}">
                            <button type="submit" class="admin-order-recovery__button">
                                <i class="fa-solid fa-paper-plane"></i>
                                {{ 'admin.order.recovery.action'|trans }}
                            </button>
                        </form>
                    {% else %}
                        <span class="admin-order-recovery__unavailable">
                            <i class="fa-solid fa-circle-info"></i>
                            {{ payment_recovery.reason|trans }}
                        </span>
                    {% endif %}
                </div>
            </article>

            <article class="admin-panel">
                <div class="admin-panel__heading">
                    <div>
                        <span>{{ 'admin.order.show.customer_eyebrow'|trans }}</span>
                        <h2>{{ 'admin.order.show.customer_title'|trans }}</h2>
                    </div>
                </div>

                <div class="admin-order-info-list">
                    <div>
                        <span>{{ 'admin.order.customer'|trans }}</span>
                        <strong>{{ order.customer ?: 'admin.order.unknown_customer'|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'common.email'|trans }}</span>
                        <strong>{{ order.email ?: 'admin.order.email_pending'|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.customer_type'|trans }}</span>
                        <strong>{{ order.user ? 'admin.order.registered_customer'|trans : 'admin.order.guest_customer'|trans }}</strong>
                    </div>
                </div>
            </article>

            <article class="admin-panel">
                <div class="admin-panel__heading">
                    <div>
                        <span>{{ 'admin.order.show.shipping_eyebrow'|trans }}</span>
                        <h2>{{ 'admin.order.show.shipping_title'|trans }}</h2>
                    </div>
                </div>

                {% set shipping_address_for_copy = order.shipping.name %}
                {% if order.email %}
                    {% set shipping_address_for_copy = shipping_address_for_copy ~ "\n" ~ order.email %}
                {% endif %}
                {% set shipping_address_for_copy = shipping_address_for_copy ~ "\n" ~ order.shipping.street ~ "\n" ~ order.shipping.postal_code ~ ' ' ~ order.shipping.city ~ "\n" ~ order.shipping.country_code %}
                {% if order.shipping.phone %}
                    {% set shipping_address_for_copy = shipping_address_for_copy ~ "\n" ~ order.shipping.phone %}
                {% endif %}

                <address
                    class="admin-order-address"
                    data-controller="admin-order-copy"
                    data-admin-order-copy-text-value="{{ shipping_address_for_copy|e('html_attr') }}"
                    data-admin-order-copy-copy-label-value="{{ 'admin.order.shipping.copy'|trans }}"
                    data-admin-order-copy-copied-label-value="{{ 'admin.order.shipping.copied'|trans }}"
                    data-admin-order-copy-copy-failed-label-value="{{ 'admin.order.shipping.copy_failed'|trans }}"
                >
                    <strong>{{ order.shipping.name }}</strong>
                    <span>{{ order.shipping.street }}</span>
                    <span>{{ order.shipping.postal_code }} {{ order.shipping.city }}</span>
                    <span>{{ order.shipping.country_code }}</span>
                    {% if order.shipping.phone %}
                        <span>{{ order.shipping.phone }}</span>
                    {% endif %}
                    <div class="admin-order-address__actions">
                        <button
                            type="button"
                            class="admin-secondary-button admin-secondary-button--small"
                            data-action="admin-order-copy#copy"
                            data-admin-order-copy-target="button"
                        >
                            <i class="fa-regular fa-copy"></i>
                            <span data-admin-order-copy-target="label">{{ 'admin.order.shipping.copy'|trans }}</span>
                        </button>
                    </div>
                </address>
            </article>

            <article class="admin-panel">
                <div class="admin-panel__heading">
                    <div>
                        <span>{{ 'admin.order.show.payment_eyebrow'|trans }}</span>
                        <h2>{{ 'admin.order.show.payment_title'|trans }}</h2>
                    </div>
                </div>

                <div class="admin-order-info-list">
                    <div>
                        <span>{{ 'admin.order.stripe_session'|trans }}</span>
                        <strong>{{ order.stripe_checkout_session_id ?: 'admin.order.not_available'|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.stripe_payment_intent'|trans }}</span>
                        <strong>{{ order.stripe_payment_intent_id ?: 'admin.order.not_available'|trans }}</strong>
                    </div>
                    <div>
                        <span>{{ 'admin.order.stripe_customer'|trans }}</span>
                        <strong>{{ order.stripe_customer_id ?: 'admin.order.not_available'|trans }}</strong>
                    </div>
                    {% if order.payment_failure_reason %}
                        <div>
                            <span>{{ 'admin.order.failure_reason'|trans }}</span>
                            <strong>{{ order.payment_failure_reason }}</strong>
                        </div>
                    {% endif %}
                </div>
            </article>
        </div>

        {% set ordered_items_for_copy = '' %}
        {% if order.items %}
            {% for item in order.items %}
                {% set item_for_copy = item.name ~ ' x' ~ item.quantity %}
                {% if item.reference %}
                    {% set item_for_copy = item_for_copy ~ ' (' ~ item.reference ~ ')' %}
                {% endif %}
                {% set ordered_items_for_copy = ordered_items_for_copy ~ (loop.first ? '' : "\n") ~ item_for_copy %}
            {% endfor %}
        {% endif %}

        <article class="admin-panel admin-order-items-panel">
            <div class="admin-panel__heading">
                <div>
                    <span>{{ 'admin.order.show.items_eyebrow'|trans }}</span>
                    <h2>{{ 'admin.order.show.items_title'|trans }}</h2>
                </div>
                {% if order.items %}
                    <div
                        data-controller="admin-order-copy"
                        data-admin-order-copy-text-value="{{ ordered_items_for_copy|e('html_attr') }}"
                        data-admin-order-copy-copy-label-value="{{ 'admin.order.items.copy'|trans }}"
                        data-admin-order-copy-copied-label-value="{{ 'admin.order.shipping.copied'|trans }}"
                        data-admin-order-copy-copy-failed-label-value="{{ 'admin.order.shipping.copy_failed'|trans }}"
                    >
                        <button
                            type="button"
                            class="admin-secondary-button admin-secondary-button--small"
                            data-action="admin-order-copy#copy"
                            data-admin-order-copy-target="button"
                        >
                            <i class="fa-regular fa-copy"></i>
                            <span data-admin-order-copy-target="label">{{ 'admin.order.items.copy'|trans }}</span>
                        </button>
                    </div>
                {% endif %}
            </div>

            {% if order.items %}
                <div class="admin-order-items">
                    {% for item in order.items %}
                        <article class="admin-order-item">
                            <span class="admin-order-item__image">
                                {% if item.image %}
                                    <img src="{{ asset(item.image) }}" alt="">
                                {% else %}
                                    <i class="fa-solid fa-box"></i>
                                {% endif %}
                            </span>
                            <span class="admin-order-item__main">
                                <strong>{{ item.name }}</strong>
                                <small>
                                    {{ item.reference ?: 'admin.order.no_reference'|trans }}
                                    {% if item.license %} - {{ item.license }}{% endif %}
                                    {% if item.category %} - {{ item.category }}{% endif %}
                                </small>
                            </span>
                            <span>{{ item.unit_price }}</span>
                            <span>x{{ item.quantity }}</span>
                            <strong>{{ item.total }}</strong>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="admin-empty-state">
                    <i class="fa-solid fa-box-open"></i>
                    <p>{{ 'admin.order.show.no_items'|trans }}</p>
                </div>
            {% endif %}
        </article>

        <article class="admin-panel admin-order-totals-panel">
            <div class="admin-order-totals">
                <div>
                    <span>{{ 'admin.order.subtotal_tax_excluded'|trans }}</span>
                    <strong>{{ order.subtotal_tax_excluded }}</strong>
                </div>
                <div>
                    <span>{{ 'overlay.delivery'|trans }} HT</span>
                    <strong>{{ order.shipping_amount_tax_excluded }}</strong>
                </div>
                <div>
                    <span>{{ 'admin.order.discount'|trans }} HT</span>
                    <strong>
                        {{ order.discount_tax_excluded }}
                        {% if order.promo_code %}<small>({{ order.promo_code }})</small>{% endif %}
                    </strong>
                </div>
                <div>
                    <span>TVA</span>
                    <strong>{{ order.tax }}</strong>
                </div>
                <div class="admin-order-totals__grand">
                    <span>{{ 'overlay.total'|trans }}</span>
                    <strong>{{ order.total }}</strong>
                </div>
            </div>
        </article>

        <div class="admin-danger-zone">
            <div>
                <strong>{{ 'admin.order.delete.title'|trans }}</strong>
                <span>{{ 'admin.order.delete.text'|trans }}</span>
            </div>
            <form method="post" action="{{ path('app_admin_orders_delete', {id: order.id}) }}" onsubmit="return confirm('{{ 'admin.order.delete.confirm'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_order_delete_' ~ order.id) }}">
                <button type="submit">
                    <i class="fa-solid fa-trash-can"></i>
                    {{ 'admin.order.action.delete'|trans }}
                </button>
            </form>
        </div>
    </section>
{% endblock %}
